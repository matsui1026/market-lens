# Copy to .env.local (or run `npm run setup`). .env.local is git-ignored.
# Never prefix these with VITE_ — VITE_ variables are bundled into the browser code.

# Your own J-Quants API key (dashboard > API Keys).
JQUANTS_API_KEY=

# Requests per minute allowed by your plan: Free=5, Light=60, Standard=120, Premium=500
JQUANTS_RATE_LIMIT_PER_MIN=5
