{
  "name": "market-lens",
  "private": true,
  "version": "1.0.0",
  "description": "J-Quants API のデータを自分の PC 上で分析・可視化する、個人学習用の非公式ツール",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 4174 --strictPort",
    "setup": "node scripts/setup.mjs",
    "check:api": "node scripts/check-api.mjs",
    "cache:clear": "node scripts/clear-cache.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:demo && playwright test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
